{
  "name": "@miorin/dsh-atlas-plugin",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Plugin panel shortcut, local bundle management, and security audits before updates.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "plugins",
    "aggregate"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "aggregate.yml",
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "README.de.md",
    "README.es.md",
    "README.fr.md",
    "README.ja.md",
    "README.pt.md",
    "README.ru.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "docs/README.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5",
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build:tools": "tsc -p tsconfig.tools.json",
    "build": "dsh-aggregate generate . && npm run build:tools && node scripts/build.mjs",
    "prepare": "npm run build 1>&2",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "node --test",
    "test": "npm run build && npm run check",
    "check": "dsh-aggregate check . && npm run build:tools && npm run test:unit && npm run typecheck && node scripts/build.mjs --check && node scripts/sync-types.mjs --check",
    "prepublishOnly": "dsh-aggregate verify-release . && npm run build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@miorin/dsh-aggregate": "0.1.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.7.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "aggregate": {
      "version": 1,
      "runtimeRowId": "dsh-atlas-plugin",
      "plugins": [
        "@miorin/dsh-plugin-panel-toggle",
        "@miorin/dsh-local-plugin-reload",
        "@miorin/dsh-plugin-security-audit"
      ],
      "defaults": {
        "@miorin/dsh-plugin-panel-toggle": true,
        "@miorin/dsh-local-plugin-reload": true,
        "@miorin/dsh-plugin-security-audit": true
      }
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@miorin/dsh-plugin-panel-toggle": "0.1.1",
    "@miorin/dsh-local-plugin-reload": "0.1.1",
    "@miorin/dsh-plugin-security-audit": "0.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miorin-chan/dsh-atlas-plugin.git"
  },
  "homepage": "https://github.com/miorin-chan/dsh-atlas-plugin#readme",
  "bugs": {
    "url": "https://github.com/miorin-chan/dsh-atlas-plugin/issues"
  }
}
