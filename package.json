{
  "name": "dsh-plugin-atlas",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A modular program for differentiable, continuous improvement of the plugin management experience.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "plugins",
    "aggregate"
  ],
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "aggregate.yml",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "docs/README.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "scripts": {
    "aggregate": "node ../../tools/dsh-aggregate/cli.mjs generate .",
    "check": "node ../../tools/dsh-aggregate/cli.mjs check .",
    "prepack": "node ../../tools/dsh-aggregate/cli.mjs check ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "aggregate": {
      "plugins": [
        "dsh-plugin-panel-toggle",
        "dsh-local-plugin-reload",
        "dsh-plugin-security-audit"
      ]
    }
  },
  "dependencies": {
    "dsh-plugin-panel-toggle": "link:../dsh-plugin-panel-toggle",
    "dsh-local-plugin-reload": "link:../dsh-local-plugin-reload",
    "dsh-plugin-security-audit": "link:../dsh-plugin-security-audit"
  }
}
